{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "UOR-R4 Sovereign Studio",
  "version": "2.0.0",
  "identifier": "io.uor.sovereign.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UOR-R4 Sovereign AI Developer Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Sovereign In-Browser & Native AI Developer Studio",
    "longDescription": "High-performance AI development studio powered by 8D Gosset E8 lattices and Hopf geometric telemetry with native Metal GPU acceleration."
  }
}